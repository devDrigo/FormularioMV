@model FluigPainel.Models.CentralChamadosViewModel
@using System.Linq
@{ ViewData["Title"] = "Central de automações"; var ativos = Model.Configuracoes.Count(x => x.Ativo); var regrasAtivas = Model.Regras.Count(x => x.Ativa); }
<style>
:root{--ink:#172033;--muted:#64748b;--line:#e5eaf2;--surface:#fff;--bg:#f5f7fb;--blue:#2563eb;--blue-soft:#eff6ff;--green:#15803d;--amber:#b45309;--red:#b91c1c}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px Inter,Segoe UI,Arial,sans-serif}.app{max-width:1380px;margin:0 auto;padding:28px 24px 60px}.hero{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin-bottom:24px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--blue);font-weight:800}.hero h1{font-size:32px;letter-spacing:-.04em;margin:5px 0 8px}.hero p{color:var(--muted);margin:0;max-width:710px;line-height:1.55}.top-actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid transparent;border-radius:9px;padding:10px 14px;text-decoration:none;cursor:pointer;font-weight:750;transition:.15s}.btn:hover{transform:translateY(-1px);filter:brightness(.98)}.primary{background:var(--blue);color:#fff}.secondary{background:#fff;color:#334155;border-color:var(--line)}.danger{background:#fff1f2;color:var(--red);border-color:#fecdd3}.soft{background:var(--blue-soft);color:#1d4ed8;border-color:#bfdbfe}.dashboard{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}.metric{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:17px}.metric small{display:block;color:var(--muted);font-weight:700}.metric strong{display:block;font-size:27px;margin-top:6px}.metric span{font-size:12px;color:var(--muted)}.tabs{display:flex;gap:4px;background:#eaf0f8;border-radius:12px;padding:4px;margin-bottom:20px;overflow:auto}.tab{white-space:nowrap;border:0;background:transparent;border-radius:9px;padding:11px 16px;color:#64748b;font-weight:750;cursor:pointer}.tab.active{background:#fff;color:var(--blue);box-shadow:0 2px 8px #17203312}.panel{display:none}.panel.active{display:block}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:8px 0 14px}.section-head h2{margin:0;font-size:21px}.section-head p{color:var(--muted);margin:5px 0 0}.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px;margin:12px 0;box-shadow:0 4px 18px #17203308}.automation{border-left:4px solid #94a3b8}.automation.active{border-left-color:#22c55e}.automation summary{cursor:pointer;list-style:none}.automation summary::-webkit-details-marker{display:none}.summary{display:flex;justify-content:space-between;align-items:center;gap:16px}.summary-main{display:flex;align-items:center;gap:12px;min-width:0}.summary-main strong{font-size:16px}.summary-main small{display:block;color:var(--muted);margin-top:4px}.status{border-radius:999px;padding:5px 9px;font-size:11px;font-weight:800;white-space:nowrap}.status.ok{background:#dcfce7;color:var(--green)}.status.off{background:#f1f5f9;color:#64748b}.status.event{background:#ede9fe;color:#6d28d9}.status.time{background:#fef3c7;color:var(--amber)}.form-section{border-bottom:1px solid var(--line);padding:6px 0 14px;margin:8px 0 18px}.form-section h3{margin:0 0 5px;font-size:16px;color:#1d4ed8}.form-section p{margin:0}.destination-section{border:1px solid #bfdbfe;background:#f8fbff;border-radius:14px;padding:16px;margin-top:18px}.destination-section h3{margin:0 0 5px;color:#1e40af}.group-title{grid-column:1/-1;border-radius:12px;padding:12px 14px;margin-top:8px;font-size:15px;font-weight:850;letter-spacing:-.01em}.group-title small{display:block;font-size:12px;font-weight:500;margin-top:3px;line-height:1.4}.group-trigger{background:#eef2ff;border:1px solid #c7d2fe;color:#3730a3}.group-call{background:#ecfdf5;border:1px solid #bbf7d0;color:#166534}.group-result{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.field{grid-column:span 4}.field.wide{grid-column:1/-1}.field.half{grid-column:span 6}label{display:flex;align-items:center;gap:4px;font-size:12px;font-weight:800;color:#475569;margin-bottom:6px}.req{color:#dc2626}input,textarea,select{width:100%;border:1px solid #cbd5e1;background:#fff;border-radius:9px;padding:10px 11px;color:var(--ink);font:inherit}textarea{min-height:104px;resize:vertical}input:focus,textarea:focus,select:focus{outline:3px solid #dbeafe;border-color:#60a5fa}.hint{font-size:12px;color:var(--muted);line-height:1.45;margin:6px 0 0}.conditional-hidden{display:none!important}.fluig-loading{opacity:.7}.fluig-error{border-color:#fca5a5;background:#fff1f2}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.schedule{display:grid;grid-template-columns:150px 1fr auto;gap:8px;align-items:center;margin:7px 0}.condition-row{display:grid;grid-template-columns:1.1fr 1fr .9fr 1.1fr .75fr .85fr auto;gap:8px;margin:8px 0}.list{display:grid;gap:10px}.empty{padding:38px;text-align:center;color:var(--muted);background:#fff;border:1px dashed #cbd5e1;border-radius:14px}.badge{background:#eff6ff;color:#1d4ed8;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:750}.readonly{padding:10px;background:#f8fafc;border:1px solid var(--line);border-radius:9px;overflow-wrap:anywhere}.chips{display:flex;gap:7px;flex-wrap:wrap}.scroll{overflow:auto;background:#fff;border:1px solid var(--line);border-radius:14px}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:13px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:#64748b;background:#f8fafc}.modal{display:none;position:fixed;inset:0;background:#172033aa;z-index:20;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.modal-box{background:#fff;border-radius:18px;max-width:920px;width:100%;max-height:94vh;overflow:auto;padding:25px;box-shadow:0 20px 70px #0004}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.modal-head h2{margin:0}.close{border:0;background:#f1f5f9;border-radius:9px;width:36px;height:36px;font-size:22px;cursor:pointer}.callout{background:var(--blue-soft);border:1px solid #bfdbfe;border-radius:12px;padding:13px 15px;color:#1e3a8a;line-height:1.5;margin:14px 0}.help-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.help-card{padding:18px;border:1px solid var(--line);border-radius:14px;background:#fff}.help-card h3{margin:0 0 7px;font-size:15px}.help-card p{color:var(--muted);line-height:1.5;margin:0}@@media(max-width:850px){.dashboard{grid-template-columns:repeat(2,1fr)}.hero{display:block}.top-actions{margin-top:16px}.steps,.help-grid{grid-template-columns:1fr}.field,.field.half{grid-column:1/-1}.condition-row{grid-template-columns:1fr}.summary{align-items:flex-start;display:block}.summary .status{display:inline-block;margin-top:10px}}
</style>
<div class="app">
<header class="hero"><div><div class="eyebrow">Central de chamados</div><h1>Automatize sem complicar</h1><p>Configure quando um chamado deve ser aberto, quais dados devem ser lidos e, opcionalmente, onde o número do chamado será gravado. A fonte e a aba servem para ler a planilha; a fonte, aba e coluna do resultado servem somente para salvar o número.</p></div><div class="top-actions"><a class="btn secondary" href="@Url.Action("Index", "Home")">Voltar ao painel</a><form method="post" action="@Url.Action("SairCentralChamados", "Home")"><button class="btn danger">Sair</button></form></div></header>
<div class="dashboard"><div class="metric"><small>Automações cadastradas</small><strong>@Model.Configuracoes.Count</strong><span>@ativos ativas</span></div><div class="metric"><small>Gatilhos integrados</small><strong>@Model.Regras.Count</strong><span>@regrasAtivas prontas para uso</span></div><div class="metric"><small>Fonte conectada</small><strong>@(Model.Fontes.Any() ? "1" : "0")</strong><span>planilha integrada</span></div><div class="metric"><small>Histórico</small><strong>@Model.Historico.Count</strong><span>últimos 30 dias</span></div></div>
<nav class="tabs"><button class="tab active" data-tab="agenda">Automações</button><button class="tab" data-tab="regras">Gatilhos integrados</button><button class="tab" data-tab="fontes">Fonte de dados</button><button class="tab" data-tab="historico">Histórico</button><button class="tab" data-tab="ajuda">Guia rápido</button></nav>
<section id="agenda" class="panel active"><div class="section-head"><div><h2>Suas automações</h2><p>Uma automação combina uma forma de disparo — por horário ou por gatilho integrado — com a ação de abrir um chamado no Fluig.</p></div><button class="btn primary" data-modal="modal-agendamento">+ Nova automação</button></div><div class="callout"><strong>Qual opção escolher?</strong> Use <b>Sincronização</b> quando uma regra precisa ler linhas da planilha. Use <b>Horário programado</b> para abrir pelo Apps Script, que já possui o fluxo funcional do Fluig.</div><div class="list">@if(!Model.Configuracoes.Any()){<div class="empty"><strong>Nenhuma automação criada ainda.</strong><br>Use “Nova automação” para começar.</div>}@foreach(var item in Model.Configuracoes){<details class="card automation @(item.Ativo ? "active" : "")"><summary><div class="summary"><div class="summary-main"><div><strong>@item.Nome</strong><small>@(item.ModoGatilho == "Evento" ? "Executa quando a planilha é sincronizada" : "Executa em horários programados")</small></div></div><span class="status @(item.Ativo ? "ok" : "off")">@(item.Ativo ? "ATIVA" : "INATIVA")</span></div></summary><form method="post" action="@Url.Action("SalvarConfiguracaoChamado", "Home")" style="margin-top:20px"><input type="hidden" name="Id" value="@item.Id"><input type="hidden" name="Tipo" value="@item.Tipo"><div class="form-section"><h3>Gatilho e conteúdo</h3><p class="hint">Defina quando avaliar, o texto enviado e, no final, o destino opcional do número.</p></div><div class="grid"><div class="field half"><label>Nome <span class="req">*</span></label><input name="Nome" value="@item.Nome" required></div><div class="field half"><label>Modo de execução <span class="req">*</span></label><select name="ModoGatilho" class="trigger" data-current="@item.ModoGatilho"><option value="Horario">Horário programado</option><option value="Evento">Sincronização da planilha</option></select></div><div class="group-title group-trigger">Gatilho<small class="event-help">Escolha o gatilho que fará o chamado ser aberto quando a planilha for sincronizada.</small><small class="schedule-help">Escolha a periodicidade e os horários em que os chamados deverão ser abertos.</small></div><div class="field wide rule-field conditional-hidden"><label>Gatilho integrado associado <span class="req">*</span></label><select name="RegraId" class="rule-select" data-current="@item.RegraId"><option value="">Selecione um gatilho integrado</option>@foreach(var regra in Model.Regras){<option value="@regra.Id" data-aba="@regra.AbaFonte">@regra.Nome</option>}</select><p class="hint">Obrigatório na sincronização. A aba será herdada do gatilho integrado.</p></div><div class="field schedule-only"><label>Periodicidade</label><select name="Periodicidade" class="period" data-current="@item.Periodicidade"><option>Diariamente</option><option>Semanalmente</option><option>Mensalmente</option><option>Trimestralmente</option><option>Semestralmente</option><option>Anualmente</option></select></div><div class="field schedule-only period-week conditional-hidden"><label>Dia da semana</label><select name="DiaSemana" data-current="@item.DiaSemana"><option value="">Selecione</option><option>Segunda-feira</option><option>Terça-feira</option><option>Quarta-feira</option><option>Quinta-feira</option><option>Sexta-feira</option><option>Sábado</option><option>Domingo</option></select></div><div class="field schedule-only period-date conditional-hidden"><label>Dia do mês</label><select name="DiaMes" data-current="@item.DiaMes">@for(var d=1;d<=31;d++){<option value="@d">@d</option>}</select></div><div class="field schedule-only period-year period-cycle conditional-hidden"><label>Mês de início</label><select name="MesAno" data-current="@item.MesAno">@for(var m=1;m<=12;m++){<option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(m)</option>}</select></div><div class="field wide schedule-only"><label>Horários</label><div class="schedule-list">@foreach(var hora in item.Horarios.DefaultIfEmpty("06:00")){<div class="schedule"><input type="time" name="Horarios" value="@hora"><span class="hint">Adicione um ou mais horários para esta periodicidade.</span><button type="button" class="btn secondary remove-time">Remover</button></div>}</div><button type="button" class="btn secondary add-time">+ Adicionar horário</button></div><div class="group-title group-call">Chamado<small>Defina os dados que serão enviados ao Fluig.</small></div><div class="field"><label>Categoria</label><select name="Categoria" class="fluig-category" data-current="@item.Categoria"><option value="">Clique para carregar categorias</option></select></div><div class="field"><label>Subcategoria</label><select name="Subcategoria" class="fluig-subcategory" data-current="@item.Subcategoria" @(!string.IsNullOrWhiteSpace(item.Subcategoria) ? "" : "disabled")><option value="">@(string.IsNullOrWhiteSpace(item.Subcategoria) ? "Selecione primeiro a categoria" : "Selecione uma subcategoria")</option>@if (!string.IsNullOrWhiteSpace(item.Subcategoria)){<option value="@item.Subcategoria" selected>@item.Subcategoria (salva)</option>}</select></div><div class="field"><label>Prazo (horas)</label><input type="number" name="PrazoHoras" value="@item.PrazoHoras" min="1"></div><div class="field wide"><label>Título <span class="req">*</span></label><input name="Titulo" value="@item.Titulo" placeholder="Ex.: Solicitação para $B" required><p class="hint">Use somente as letras das colunas da planilha para inserir dados da linha: <b>$A</b> pega a coluna A, <b>$B</b> pega a coluna B, <b>$C</b> pega a coluna C, <b>$D</b> pega a coluna D e assim por diante. Exemplo: <b>Funcionário: $B</b>. Os valores são preenchidos quando o gatilho integrado encontra a linha.</p></div><div class="field wide"><label>Descrição <span class="req">*</span></label><textarea name="Descricao" required>@item.Descricao</textarea></div><div class="group-title group-result">Salvamento do número do chamado<small>Preencha a planilha, a aba e a coluna para registrar o número retornado. Se deixar a coluna vazia, o chamado será aberto sem gravar o retorno.</small></div><div class="field"><label>Planilha de salvamento</label><select name="ColunaNumeroChamadoFonteId" data-current="@item.ColunaNumeroChamadoFonteId">@foreach(var fonteColuna in Model.Fontes){<option value="@fonteColuna.Id">@fonteColuna.Nome</option>}</select></div><div class="field"><label>Aba de salvamento</label><select name="ColunaNumeroChamadoAba" data-current="@item.ColunaNumeroChamadoAba">@foreach(var f in Model.Fontes.Take(1)){foreach(var aba in f.Abas){<option value="@aba" data-fonte="@f.Id">@aba</option>}}</select></div><div class="field"><label>Coluna do número do chamado</label><input name="ColunaNumeroChamado" value="@item.ColunaNumeroChamado" placeholder="Opcional: K ou CHAMADO"><p class="hint">A coluna pertence à planilha e aba selecionadas. Se vazia, abre sem alterar a planilha.</p></div><div class="field"><label>Status</label><select name="Ativo" data-current="@(item.Ativo ? "true" : "false")"><option value="true">Ativa</option><option value="false">Inativa</option></select></div></div><div class="actions"><button class="btn primary">Salvar alterações</button><button type="button" class="btn secondary cancel-edit">Cancelar</button><button class="btn danger" formaction="@Url.Action("ExcluirConfiguracaoChamado", "Home")" name="id" value="@item.Id" onclick="return confirm('Excluir esta automação?')">Excluir automação</button></div></form></details>}</div></section>
<section id="regras" class="panel"><div class="section-head"><div><h2>Gatilhos integrados</h2><p>Os gatilhos integrados definem quais linhas da planilha podem gerar chamados.</p></div><button class="btn primary" data-modal="modal-regra">+ Novo gatilho integrado</button></div><div class="list">@foreach(var r in Model.Regras){<details class="card"><summary><div class="summary"><div><strong>@r.Nome</strong><small>Aba: @(string.IsNullOrWhiteSpace(r.AbaFonte) ? "não definida" : r.AbaFonte) · @r.Condicoes.Count condição(ões)</small></div><span class="status @(r.Ativa ? "ok" : "off")">@(r.Ativa ? "ATIVA" : "INATIVA")</span></div></summary><form method="post" action="@Url.Action("SalvarRegraChamado", "Home")" style="margin-top:20px"><input type="hidden" name="Id" value="@r.Id"><div class="grid"><div class="field half"><label>Nome <span class="req">*</span></label><input name="Nome" value="@r.Nome" required></div><div class="field half"><label>Descrição</label><input name="Descricao" value="@r.Descricao"></div><div class="field"><label>Fonte para ler dados <span class="req">*</span></label><select name="FonteId" data-current="@r.FonteId">@foreach(var f in Model.Fontes.Take(1)){<option value="@f.Id">@f.Nome</option>}</select></div><div class="field"><label>Aba para ler dados <span class="req">*</span></label><select name="AbaFonte" data-current="@r.AbaFonte">@foreach(var f in Model.Fontes.Take(1)){foreach(var aba in f.Abas){<option value="@aba" data-fonte="@f.Id">@aba</option>}}</select></div><div class="field"><label>Combinação</label><select name="Combinacao" data-current="@r.Combinacao"><option value="E">E — todas</option><option value="OU">OU — qualquer uma</option></select></div><div class="field wide"><label>Condições</label><div class="condition-list">@if(r.Condicoes.Any()){for(var i=0;i<r.Condicoes.Count;i++){<div class="condition-row"><input name="Condicoes[@i].Coluna" value="@r.Condicoes[i].Coluna" placeholder="Coluna ou cabeçalho"><select name="Condicoes[@i].Operador" data-current="@r.Condicoes[i].Operador"><option>Igual a</option><option>Menor que</option><option>Diferente de</option><option>Nulo</option></select><select name="Condicoes[@i].TipoValor" class="condition-type condition-type-field" data-current="@r.Condicoes[i].TipoValor"><option>Texto</option><option>Data</option><option>Número</option></select><select name="Condicoes[@i].ModoData" class="date-mode conditional-hidden" data-current="@r.Condicoes[i].ModoData"><option value="Hoje">Hoje</option><option value="Ontem">Ontem</option><option value="1 mes atrás">1 mês atrás</option><option value="2 meses atrás">2 meses atrás</option><option value="3 meses atrás">3 meses atrás</option><option value="6 meses atrás">6 meses atrás</option><option value="12 meses atrás">12 meses atrás</option><option value="Data específica">Data específica</option></select><input name="Condicoes[@i].Valor" value="@r.Condicoes[i].Valor" placeholder="Valor ou data"><input type="number" name="Condicoes[@i].PeriodoQuantidade" value="@r.Condicoes[i].PeriodoQuantidade" min="1" class="period-quantity conditional-hidden" placeholder="Quantidade"><select name="Condicoes[@i].PeriodoUnidade" data-current="@r.Condicoes[i].PeriodoUnidade" class="period-unit conditional-hidden"><option>dias</option><option>meses</option><option>anos</option></select><small class="period-explanation conditional-hidden">A referência da data é calculada automaticamente a partir de hoje.</small><button type="button" class="btn secondary remove-condition">Remover</button></div>}}else{<div class="condition-row"><input name="Condicoes[0].Coluna" placeholder="Coluna ou cabeçalho" required><select name="Condicoes[0].Operador"><option>Igual a</option><option>Menor que</option><option>Diferente de</option><option>Nulo</option></select><select name="Condicoes[0].TipoValor" class="condition-type condition-type-field"><option>Texto</option><option>Data</option><option>Número</option></select><select name="Condicoes[0].ModoData" class="date-mode conditional-hidden"><option value="Hoje">Hoje</option><option value="Ontem">Ontem</option><option value="1 mes atrás">1 mês atrás</option><option value="2 meses atrás">2 meses atrás</option><option value="3 meses atrás">3 meses atrás</option><option value="6 meses atrás">6 meses atrás</option><option value="12 meses atrás">12 meses atrás</option><option value="Data específica">Data específica</option></select><input name="Condicoes[0].Valor" placeholder="Valor ou data"><input type="number" name="Condicoes[0].PeriodoQuantidade" value="1" min="1" class="period-quantity conditional-hidden"><select name="Condicoes[0].PeriodoUnidade" class="period-unit conditional-hidden"><option>dias</option><option>meses</option><option>anos</option></select><small class="period-explanation conditional-hidden">A referência da data é calculada automaticamente a partir de hoje.</small><button type="button" class="btn secondary remove-condition">Remover</button></div>}</div><button type="button" class="btn secondary add-condition">+ Adicionar condição</button><p class="hint">Informe a coluna pela letra (A, B, C) ou pelo cabeçalho exato.</p></div></div><input type="hidden" name="Condicao" value="Condições configuradas por coluna"><div class="actions"><button class="btn primary">Salvar regra</button><button class="btn danger" formaction="@Url.Action("ExcluirRegraChamado", "Home")" name="id" value="@r.Id" onclick="return confirm('Excluir esta regra?')">Excluir regra</button></div></form></details>}</div></section>
<section id="fontes" class="panel"><div class="section-head"><div><h2>Fonte conectada</h2><p>Esta planilha é sincronizada automaticamente pelo Apps Script.</p></div></div>@foreach(var f in Model.Fontes.Take(1)){<div class="card"><div class="grid"><div class="field"><label>Nome</label><div class="readonly">@f.Nome</div></div><div class="field"><label>Tipo</label><div class="readonly">@f.Tipo</div></div><div class="field wide"><label>Link</label><div class="readonly"><a href="@f.Endereco" target="_blank">@f.Endereco</a></div></div><div class="field wide"><label>Abas disponíveis</label><div class="chips">@foreach(var aba in f.Abas){<span class="badge">@aba</span>}</div></div></div></div>}</section>
<section id="historico" class="panel"><div class="section-head"><div><h2>Histórico recente</h2><p>Chamados abertos pelas automações nos últimos 30 dias.</p></div></div><div class="scroll"><table><thead><tr><th>Data</th><th>Automação</th><th>Chamado</th><th>Referência</th><th>Status</th><th>Mensagem</th></tr></thead><tbody>@if(!Model.Historico.Any()){<tr><td colspan="6">Nenhum chamado automático registrado.</td></tr>}else{foreach(var h in Model.Historico){<tr><td>@h.AbertoEm.ToString("dd/MM/yyyy HH:mm")</td><td>@h.ConfigNome</td><td><strong>@(string.IsNullOrWhiteSpace(h.NumeroChamado) ? "Não identificado" : h.NumeroChamado)</strong></td><td>@h.Referencia</td><td>@h.Status</td><td>@h.Mensagem</td></tr>}}</tbody></table></div></section>
<section id="ajuda" class="panel"><div class="section-head"><div><h2>Guia rápido</h2><p>Escolha o caminho de acordo com o tipo de automação.</p></div></div><div class="help-grid"><div class="help-card"><h3>1. Crie uma regra</h3><p>Defina quais colunas e valores identificam uma linha elegível. Use E para exigir tudo ou OU para aceitar qualquer condição.</p></div><div class="help-card"><h3>2. Crie uma automação</h3><p>Use sincronização para reagir à planilha ou horário programado para executar em momentos definidos.</p></div><div class="help-card"><h3>3. Teste com segurança</h3><p>Confira título, descrição e coluna de retorno. Primeiro mantenha a automação inativa e valide a regra.</p></div></div><div class="callout"><strong>Execução:</strong> horários e gatilhos que dependem da planilha são executados pelo Apps Script integrado ao Fluig.</div></section>
</div>
<div id="modal-agendamento" class="modal"><div class="modal-box"><div class="modal-head"><h2>Nova automação</h2><button type="button" class="close">×</button></div><div class="callout">Escolha <strong>Sincronização</strong> para avaliar uma regra da planilha. Escolha <strong>Horário programado</strong> para uma rotina recorrente executada pelo Apps Script.</div><form method="post" action="@Url.Action("SalvarConfiguracaoChamado", "Home")"><input type="hidden" name="Tipo" value="PADRAO"><div class="grid"><div class="field half"><label>Nome <span class="req">*</span></label><input name="Nome" required placeholder="Ex.: Conferir pendências diárias"></div><div class="field half"><label>Modo <span class="req">*</span></label><select name="ModoGatilho" class="trigger"><option value="Horario">Horário programado</option><option value="Evento">Sincronização da planilha</option></select></div><div class="group-title group-trigger">Gatilho<small class="event-help">Escolha o gatilho que fará o chamado ser aberto quando a planilha for sincronizada.</small><small class="schedule-help">Escolha a periodicidade e os horários em que os chamados deverão ser abertos.</small></div><div class="field wide rule-field conditional-hidden"><label>Gatilho integrado associado <span class="req">*</span></label><select name="RegraId" class="rule-select"><option value="">Selecione um gatilho integrado</option>@foreach(var r in Model.Regras){<option value="@r.Id" data-aba="@r.AbaFonte">@r.Nome</option>}</select></div><div class="field schedule-only"><label>Periodicidade</label><select name="Periodicidade" class="period"><option>Diariamente</option><option>Semanalmente</option><option>Mensalmente</option><option>Trimestralmente</option><option>Semestralmente</option><option>Anualmente</option></select></div><div class="field schedule-only period-week conditional-hidden"><label>Dia da semana</label><select name="DiaSemana"><option value="">Selecione</option><option>Segunda-feira</option><option>Terça-feira</option><option>Quarta-feira</option><option>Quinta-feira</option><option>Sexta-feira</option><option>Sábado</option><option>Domingo</option></select></div><div class="field schedule-only period-date conditional-hidden"><label>Dia do mês</label><select name="DiaMes">@for(var d=1;d<=31;d++){<option value="@d">@d</option>}</select></div><div class="field schedule-only period-year period-cycle conditional-hidden"><label>Mês de início</label><select name="MesAno">@for(var m=1;m<=12;m++){<option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(m)</option>}</select></div><div class="field wide schedule-only"><label>Horários</label><div class="schedule-list"><div class="schedule"><input type="time" name="Horarios" value="06:00"><span class="hint">Adicione um ou mais horários para esta periodicidade.</span><button type="button" class="btn secondary remove-time">Remover</button></div></div><button type="button" class="btn secondary add-time">+ Adicionar horário</button></div><div class="group-title group-call">Chamado<small>Defina os dados que serão enviados ao Fluig.</small></div><div class="field"><label>Categoria</label><select name="Categoria" class="fluig-category"><option value="">Clique para carregar categorias</option></select></div><div class="field"><label>Subcategoria</label><select name="Subcategoria" class="fluig-subcategory" disabled><option value="">Selecione primeiro a categoria</option></select></div><div class="field"><label>Prazo (horas)</label><input type="number" name="PrazoHoras" value="24" min="1"></div><div class="field wide"><label>Título <span class="req">*</span></label><input name="Titulo" required placeholder="Ex.: Solicitação para $B"><p class="hint">Use $A, $B, $C, $D... para inserir o valor da coluna correspondente da linha encontrada.</p></div><div class="field wide"><label>Descrição <span class="req">*</span></label><textarea name="Descricao" required></textarea><p class="hint">Exemplo: <b>Colaborador: $B</b> — $B será substituído pelo valor da coluna B.</p></div><div class="group-title group-result">Salvamento do número do chamado<small>Preencha a planilha, a aba e a coluna para registrar o número retornado. Se deixar a coluna vazia, o chamado será aberto sem gravar o retorno.</small></div><div class="field"><label>Planilha de salvamento</label><select name="ColunaNumeroChamadoFonteId">@foreach(var fonteColuna in Model.Fontes){<option value="@fonteColuna.Id">@fonteColuna.Nome</option>}</select></div><div class="field"><label>Aba de salvamento</label><select name="ColunaNumeroChamadoAba">@foreach(var f in Model.Fontes.Take(1)){foreach(var aba in f.Abas){<option value="@aba" data-fonte="@f.Id">@aba</option>}}</select></div><div class="field"><label>Coluna do número do chamado</label><input name="ColunaNumeroChamado" placeholder="Opcional"></div></div><div class="actions"><button class="btn primary">Criar automação</button></div></form></div></div>
<div id="modal-regra" class="modal"><div class="modal-box"><div class="modal-head"><h2>Nova regra</h2><button type="button" class="close">×</button></div><div class="callout">Uma condição simples pode ser “SITUACAO igual a Ativo”. Para combinar filtros, adicione outras condições.</div><form method="post" action="@Url.Action("SalvarRegraChamado", "Home")"><div class="grid"><div class="field half"><label>Nome <span class="req">*</span></label><input name="Nome" required placeholder="Ex.: Colaborador recém-admitido"></div><div class="field half"><label>Descrição</label><input name="Descricao"></div><div class="field"><label>Fonte <span class="req">*</span></label><select name="FonteId">@foreach(var f in Model.Fontes.Take(1)){<option value="@f.Id">@f.Nome</option>}</select></div><div class="field"><label>Aba para ler dados <span class="req">*</span></label><select name="AbaFonte">@foreach(var f in Model.Fontes.Take(1)){foreach(var aba in f.Abas){<option value="@aba" data-fonte="@f.Id">@aba</option>}}</select></div><div class="field"><label>Combinação</label><select name="Combinacao"><option value="E">E — todas</option><option value="OU">OU — qualquer uma</option></select></div><div class="field wide"><label>Condições</label><div class="condition-list"><div class="condition-row"><input name="Condicoes[0].Coluna" placeholder="Coluna ou cabeçalho" required><select name="Condicoes[0].Operador"><option>Igual a</option><option>Menor que</option><option>Diferente de</option><option>Nulo</option></select><select name="Condicoes[0].TipoValor" class="condition-type condition-type-field"><option>Texto</option><option>Data</option><option>Número</option></select><input name="Condicoes[0].Valor" placeholder="Valor ou data"><input type="number" name="Condicoes[0].PeriodoQuantidade" value="1" min="1" class="period-quantity conditional-hidden"><select name="Condicoes[0].PeriodoUnidade" class="period-unit conditional-hidden"><option>dias</option><option>meses</option><option>anos</option></select><small class="period-explanation conditional-hidden">A referência da data é calculada automaticamente a partir de hoje.</small><button type="button" class="btn secondary remove-condition">Remover</button></div></div><button type="button" class="btn secondary add-condition">+ Adicionar condição</button></div></div><input type="hidden" name="Condicao" value="Condições configuradas por coluna"><div class="actions"><button class="btn primary">Salvar regra</button></div></form></div></div>

<script>
(function(){
 const $=s=>Array.from(document.querySelectorAll(s));
 function atualizarAbasDestino(form){const fonte=form.querySelector('[name=ColunaNumeroChamadoFonteId]'), aba=form.querySelector('[name=ColunaNumeroChamadoAba]');if(!fonte||!aba)return;const fontes=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Fontes.Select(x => new { id=x.Id, abas=x.Abas })));const atual=aba.dataset.current||aba.value;const f=fontes.find(x=>x.id===fonte.value)||fontes[0];aba.innerHTML=(f?.abas||[]).map(x=>'<option value="'+x+'">'+x+'</option>').join('');if((f?.abas||[]).includes(atual))aba.value=atual;}
 const datasetSubcategoria='ds_subcategorias_chamado';
 async function carregarDataset(select,dataset,categoria){
  select.classList.add('fluig-loading');select.disabled=true;
  try{const url='@Url.Action("FluigDataset", "Home")?dataset='+encodeURIComponent(dataset)+(categoria?'&categoria='+encodeURIComponent(categoria):'');const r=await fetch(url);if(!r.ok)throw new Error('HTTP '+r.status);const j=await r.json();const values=(j.content&&j.content.values)||[];const key=dataset===datasetSubcategoria?'SUBCATEGORIA':'CATEGORIA';select.innerHTML='<option value="">Selecione</option>';values.map(x=>x[key]||x.CATEGORIA||x.SUBCATEGORIA).filter(Boolean).forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;select.appendChild(o);});if(select.dataset.current){const saved=String(select.dataset.current);let found=Array.from(select.options).find(o=>o.value===saved);if(!found){found=document.createElement('option');found.value=saved;found.textContent=saved+' (salva)';select.appendChild(found);}select.value=saved;}select.classList.remove('fluig-error');}catch(e){select.innerHTML='<option value="">Não foi possível carregar</option>';select.classList.add('fluig-error');}finally{select.classList.remove('fluig-loading');select.disabled=false;}
 }
 function prepararCombosFluig(form){const cat=form.querySelector('.fluig-category'),sub=form.querySelector('.fluig-subcategory');if(!cat||!sub)return;const carregar=()=>{if(cat.dataset.loaded)return;cat.dataset.loaded='1';carregarDataset(cat,'ds_categorias_chamado','');};cat.addEventListener('focus',carregar);cat.addEventListener('click',carregar);cat.addEventListener('change',()=>{sub.dataset.current='';sub.disabled=!cat.value;if(cat.value)carregarDataset(sub,datasetSubcategoria,cat.value);else sub.innerHTML='<option value="">Selecione primeiro a categoria</option>';});carregar();if(cat.dataset.current){setTimeout(()=>{if(cat.value)carregarDataset(sub,datasetSubcategoria,cat.value);},250);}}
 function selectCurrent(){ $("select[data-current]").forEach(x=>{if(x.dataset.current)x.value=x.dataset.current;}); }
 function update(form){const trigger=form.querySelector('.trigger'), eventMode=trigger&&trigger.value==='Evento';const rule=form.querySelector('.rule-field');if(rule){const select=rule.querySelector('select');rule.classList.toggle('conditional-hidden',!eventMode);if(select)select.required=eventMode;}form.querySelectorAll('.schedule-only').forEach(x=>x.classList.toggle('conditional-hidden',eventMode));const eh=form.querySelector('.event-help'),sh=form.querySelector('.schedule-help');if(eh)eh.classList.toggle('conditional-hidden',!eventMode);if(sh)sh.classList.toggle('conditional-hidden',eventMode);if(!eventMode){const p=form.querySelector('.period')?.value||'Diariamente';form.querySelectorAll('.period-week').forEach(x=>x.classList.toggle('conditional-hidden',p!=='Semanalmente'));form.querySelectorAll('.period-date').forEach(x=>x.classList.toggle('conditional-hidden',!['Mensalmente','Trimestralmente','Semestralmente','Anualmente'].includes(p)));form.querySelectorAll('.period-year').forEach(x=>x.classList.toggle('conditional-hidden',p!=='Anualmente'));form.querySelectorAll('.period-cycle').forEach(x=>x.classList.toggle('conditional-hidden',!['Trimestralmente','Semestralmente','Anualmente'].includes(p)));}}
 function condition(row){const op=row.querySelector('select[name$=".Operador"]'),type=row.querySelector('.condition-type'),typeField=row.querySelector('.condition-type-field'),val=row.querySelector('input[name$=".Valor"]'),q=row.querySelector('.period-quantity'),u=row.querySelector('.period-unit'),dm=row.querySelector('.date-mode'),ex=row.querySelector('.period-explanation');if(!op)return;const nul=op.value==='Nulo';const t=type?.value||'Texto';if(typeField)typeField.classList.toggle('conditional-hidden',nul);if(dm)dm.classList.toggle('conditional-hidden',nul||t!=='Data');if(val){if(!nul)val.type=t==='Número'?'number':(t==='Data'&&dm&&dm.value==='Data específica'?'date':'text');val.classList.toggle('conditional-hidden',nul||t==='Data'&&(!dm||dm.value!=='Data específica'));}if(q)q.classList.add('conditional-hidden');if(u)u.classList.add('conditional-hidden');if(ex)ex.classList.add('conditional-hidden');}
 selectCurrent(); $('form').forEach(f=>{prepararCombosFluig(f);const t=f.querySelector('.trigger');if(t){t.addEventListener('change',()=>update(f));update(f);}const df=f.querySelector('[name=ColunaNumeroChamadoFonteId]');if(df){df.addEventListener('change',()=>atualizarAbasDestino(f));atualizarAbasDestino(f);}const p=f.querySelector('.period');if(p)p.addEventListener('change',()=>update(f));f.querySelectorAll('.condition-row').forEach(r=>{condition(r);r.querySelectorAll('select').forEach(sel=>sel.addEventListener('change',()=>condition(r)));});const add=f.querySelector('.add-time');const list=f.querySelector('.schedule-list');if(add&&list)add.onclick=()=>{const row=list.querySelector('.schedule').cloneNode(true);row.querySelector('input').value='';list.appendChild(row);};});
 document.addEventListener('click',e=>{if(e.target.classList.contains('remove-time')){const list=e.target.closest('.schedule-list');if(list.children.length>1)e.target.closest('.schedule').remove();}if(e.target.classList.contains('add-condition')){const list=e.target.previousElementSibling,n=list.children.length,row=list.querySelector('.condition-row').cloneNode(true);row.querySelectorAll('input').forEach(i=>{i.value='';i.name=i.name.replace(/\[0\]/,'['+n+']');});row.querySelectorAll('select').forEach(sel=>{if(sel.name.includes('.Operador'))sel.name='Condicoes['+n+'].Operador';else if(sel.name.includes('.TipoValor'))sel.name='Condicoes['+n+'].TipoValor';else if(sel.name.includes('.ModoData'))sel.name='Condicoes['+n+'].ModoData';else if(sel.name.includes('.PeriodoQuantidade'))sel.name='Condicoes['+n+'].PeriodoQuantidade';else if(sel.name.includes('.PeriodoUnidade'))sel.name='Condicoes['+n+'].PeriodoUnidade';});list.appendChild(row);condition(row);row.querySelectorAll('select').forEach(sel=>sel.addEventListener('change',()=>condition(row)));}if(e.target.classList.contains('remove-condition')){const list=e.target.closest('.condition-list');if(list.children.length>1)e.target.closest('.condition-row').remove();}});
 $('.tab').forEach(t=>t.onclick=()=>{$('.tab,.panel').forEach(x=>x.classList.remove('active'));t.classList.add('active');document.getElementById(t.dataset.tab).classList.add('active');});
 $('[data-modal]').forEach(b=>b.onclick=()=>document.getElementById(b.dataset.modal).classList.add('open'));$('.close').forEach(b=>b.onclick=()=>b.closest('.modal').classList.remove('open'));$('.cancel-edit').forEach(b=>b.onclick=()=>{const f=b.closest('form');if(f){f.reset();selectCurrent();update(f);f.querySelector('.fluig-category')?.dispatchEvent(new Event('change'));}b.closest('details')?.removeAttribute('open');});
 $('.rule-select').forEach(s=>s.onchange=()=>{const o=s.options[s.selectedIndex];const hint=s.closest('.rule-field')?.querySelector('.rule-aba-hint');if(hint)hint.textContent=o?.dataset.aba||'';});
})();
</script>
