@model FluigPainel.Models.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login - Solicitações Fluig";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 420px;
            overflow: hidden;
        }

        .login-header {
            background: #1e40af;
            color: white;
            padding: 30px;
            text-align: center;
        }

            .login-header h1 {
                font-size: 24px;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .login-header p {
                opacity: 0.9;
                font-size: 14px;
            }

        .login-form {
            padding: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: #374151;
            font-size: 14px;
        }

        input[type="text"],
        input[type="password"],
        input[type="number"] {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 6px;
            font-size: 15px;
            transition: all 0.2s;
        }

            input[type="text"]:focus,
            input[type="password"]:focus,
            input[type="number"]:focus {
                outline: none;
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

        input[type="number"] {
            width: 120px;
        }

        .form-help {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 4px;
            font-size: 13px;
            color: #6b7280;
        }

            .form-help .seconds-note {
                font-size: 12px;
                color: #9ca3af;
            }

        .error-message {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            display: none;
        }

            .error-message.show {
                display: block;
            }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: #1e40af;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 10px;
        }

            .btn-login:hover {
                background: #1e3a8a;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(30, 64, 175, 0.2);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .login-footer {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            font-size: 13px;
        }

        @@media (max-width: 480px) {
            .login-container {
                max-width: 100%;
            }

            .login-header,
            .login-form {
                padding: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>Solicitações Fluig</h1>
            <p>Acesso ao painel de solicitações</p>
        </div>

        <div class="login-form">
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="error-message show" id="errorMessage">
                    ⚠️ @ViewBag.Error
                </div>
            }

            <form method="post" id="loginForm">
                <div class="form-group">
                    <label for="Usuario">Usuário Fluig</label>
                    <input type="text" id="Usuario" name="Usuario"
                           value="@Model?.Usuario"
                           placeholder="Digite seu usuário"
                           required>
                </div>

                <div class="form-group">
                    <label for="Senha">Senha</label>
                    <input type="password" id="Senha" name="Senha"
                           placeholder="Digite sua senha"
                           required>
                </div>

                <div class="form-group">
                    <label for="Papel">Papel (Role)</label>
                    <input type="text" id="Papel" name="Papel"
                           value="@(Model?.Papel ?? "TI35")"
                           placeholder="Ex: TI35"
                           required>
                </div>

                <div class="form-group">
                    <label for="RefreshSeconds">Tempo de Auto-Refresh</label>
                    <div class="form-help">
                        <input type="number" id="RefreshSeconds" name="RefreshSeconds"
                               value="@(Model?.RefreshSeconds ?? 30)"
                               min="10" max="600" step="5"
                               required>
                        <span class="seconds-note">segundos (10-600)</span>
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    🔐 Entrar no Sistema
                </button>
            </form>
        </div>

        <div class="login-footer">
            Configure o tempo de atualização automática conforme sua necessidade
        </div>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const usuario = document.getElementById('Usuario').value;
            const senha = document.getElementById('Senha').value;
            const refreshSeconds = document.getElementById('RefreshSeconds').value;
            const errorMessage = document.getElementById('errorMessage');

            // Validar campos
            if (!usuario || !senha) {
                e.preventDefault();
                if (errorMessage) {
                    errorMessage.textContent = '⚠️ Usuário e senha são obrigatórios';
                    errorMessage.classList.add('show');
                }
                return false;
            }

            if (refreshSeconds < 10 || refreshSeconds > 600) {
                e.preventDefault();
                if (errorMessage) {
                    errorMessage.textContent = '⚠️ O tempo de refresh deve estar entre 10 e 600 segundos';
                    errorMessage.classList.add('show');
                }
                return false;
            }

            return true;
        });
    </script>
</body>
</html>