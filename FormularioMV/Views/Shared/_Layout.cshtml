<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FormsMV</title>
    <link rel="icon" href="https://www.einstein.br/PortalAssets/images/einstein.ico?rev=23" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FormsMV.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <div class="navbar-left">
                    <a class="navbar-brand" href="/">
                        <img src="https://www.novaconcursos.com.br/portal/wp-content/uploads/2014/07/edital-hugo2-2014-300x165.png" alt="Hospital Albert Einstein Logo" />
                    </a>
                </div>
                <div class="navbar-right">
                    <a class="navbar-brand" href="/">
                        <img src="https://midias.em.com.br/_midias/jpg/2023/12/01/mv-32781077.jpg" alt="Outro Logo" />
                    </a>
                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
