@{
    ViewData["Title"] = "Solicitação de Transporte";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>
<body>
<div class="container py-4">
    <h2 class="text-center">@ViewData["Title"]</h2>
    <form id="formSolicitacao" method="post" asp-action="Enviar">

        <h4>Sinais Vitais</h4>
        <div class="form-row">
            <div class="form-group col-md-2">
                <label>FC*</label>
                <div class="input-group">
                    <input type="number" class="form-control" name="fc" max="999" required />
                    <div class="input-group-append"><span class="input-group-text">bpm</span></div>
                </div>
            </div>
            <div class="form-group col-md-2">
                <label>FR*</label>
                <div class="input-group">
                    <input type="number" class="form-control" name="fr" max="99" required />
                    <div class="input-group-append"><span class="input-group-text">ipm</span></div>
                </div>
            </div>
            <div class="form-group col-md-2">
                <label>Tax*</label>
                <div class="input-group">
                    <input type="number" class="form-control" name="tax" max="99" step="0.1" required />
                    <div class="input-group-append"><span class="input-group-text">°C</span></div>
                </div>
            </div>
            <div class="form-group col-md-3">
                <label>PA*</label>
                <div class="input-group">
                    <input type="text" class="form-control" name="pa" id="pa" placeholder="000/000" required />
                    <div class="input-group-append"><span class="input-group-text">mm Hg</span></div>
                </div>
            </div>
<div class="form-group col-md-3">
    <label>Sat O₂*</label>
    <div class="d-flex align-items-center">
        <div class="input-group">
            <input type="number" class="form-control" name="sat" max="999" id="satInput" required />
            <div class="input-group-append"><span class="input-group-text">%</span></div>
        </div>
        <div class="form-check ml-2 mb-0">
            <input class="form-check-input" type="checkbox" id="satNaoAval" name="satNaoAval" style="margin-top:0;">
            <label class="form-check-label mb-0" for="satNaoAval" style="user-select:none;">Não avaliado</label>
        </div>
    </div>
</div>


        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Sensório*</label>
                <select class="form-control" name="sensorio" required>
                    <option>Alerta</option>
                    <option>Responde a comando de voz</option>
                    <option>Responde a dor</option>
                    <option>Não responde a nada</option>
                    <option>Não avaliado</option>
                </select>
            </div>
            <div class="form-group col-md-6">
                <label>Débito urinário*</label>
                <select class="form-control" name="debito_urina" required>
                    <option>Normal</option>
                    <option>Oligúria &lt;0,5ml/kg/h</option>
                    <option>Anúria</option>
                    <option>Não avaliado</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Suporte O₂*</label>
            <select class="form-control" id="suporteO2" name="suporte_o2" required>
                <option>Ar ambiente</option>
                <option>Óculos nasal ou cateter nasal</option>
                <option>Campânula</option>
                <option>Máscara de Venturi ou Hudson</option>
                <option>Ventilação mecânica</option>
                <option>Ventilação não-invasiva</option>
                <option>Cateter de alto fluxo</option>
                <option>CPAP</option>
            </select>
        </div>
        <div id="suporte-fields"></div>

        <hr />

        <h4>Transporte</h4>
        <div class="form-group">
            <label>Isolamento necessário?*</label>
            <select class="form-control" id="isolamentoSel" name="isolamento" required>
                <option value="Não">Não</option>
                <option value="Sim">Sim</option>
            </select>
        </div>
        <div class="form-group" id="germeContainer" style="display:none;">
            <label>Germe*</label>
            <select class="form-control" name="germe">
                <option>Rubéola</option>
                <option>Sarampo</option>
                <option>Varicela</option>
                <option>Zoster disseminado</option>
                <option>Outros</option>
                <option>Bactéria multirresistente</option>
                <option>Clostridium difficille</option>
                <option>Coqueluche</option>
                <option>Tuberculose pulmonar bacilífera (mycobacterium tuberculosis)</option>
                <option>Vírus Sincicial Respiratório ou Vírus Parainfluenza</option>
                <option>Isolamento protetor</option>
                <option>Doença Meningocócica</option>
            </select>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Drogas vasoativas?*</label>
                <select class="form-control" id="vasoSel" name="vaso" required>
                    <option value="Não">Não</option>
                    <option value="Sim">Sim</option>
                </select>
            </div>
            <div class="form-group col-md-4" id="vasoFields" style="display:none;">
                <label>Nome da droga*</label>
                <input type="text" class="form-control" name="nome_vaso" />
            </div>
            <div class="form-group col-md-4" id="doseFields" style="display:none;">
                <label>Dosagem*</label>
                <input type="text" class="form-control" name="dose_vaso" />
            </div>
        </div>

        <div class="form-group">
            <label>Evolução do caso*</label>
            <textarea class="form-control" name="evolucao" rows="4" maxlength="3000" required></textarea>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Origem*</label>
                <input type="text" class="form-control" name="origem" required />
            </div>
            <div class="form-group col-md-4">
                <label>Destino*</label>
                <input type="text" class="form-control" name="destino" required />
            </div>
            <div class="form-group col-md-4">
                <label>Data e horário da alta*</label>
                <input type="datetime-local" class="form-control" name="dt_alta" required />
            </div>
        </div>

        <h4>Contato</h4>
        <div class="form-group">
            <label>Profissional responsável*</label>
            <input type="text" class="form-control" name="contato_nome" required />
        </div>
        <div class="form-group">
            <label>Telefone*</label>
            <input type="tel" class="form-control" name="contato_tel" required />
        </div>

        <button type="submit" class="btn btn-primary">Enviar</button>
    </form>
</div>

<!-- (...) resto do head e html igual ao seu -->

<script>
    // Função para limitar quantidade de dígitos
    function limitarDigitos(input, maxLength) {
        input.addEventListener('input', function () {
            if (this.value.length > maxLength) {
                this.value = this.value.slice(0, maxLength);
            }
        });
    }

    // Limitar campos fixos na tela inicial
    document.addEventListener('DOMContentLoaded', function () {
        limitarDigitos(document.querySelector('[name="fc"]'), 2);
        limitarDigitos(document.querySelector('[name="fr"]'), 2);
        limitarDigitos(document.querySelector('[name="tax"]'), 2);
        limitarDigitos(document.querySelector('[name="sat"]'), 3);
    });

    // Máscara PA XXX/XXX
    $('#pa').on('input', function () {
        this.value = this.value.replace(/\D/g, '').slice(0, 6).replace(/(\d{3})(\d{0,3})/, function (m, p1, p2) {
            return p1 + (p2 ? '/' + p2 : '');
        });
    });

    // Desabilita Sat se Não Avaliado
    $('#satNaoAval').change(function () {
        $('#satInput').prop('disabled', this.checked).val(this.checked ? '' : $('#satInput').val());
    });

    // Exibe campos de suporte conforme seleção
    $('#suporteO2').change(function () {
        const val = $(this).val();
        const c = $('#suporte-fields');
        c.empty();
        if (['Óculos nasal ou cateter nasal', 'Campânula', 'Máscara de Venturi ou Hudson', 'Cateter de alto fluxo'].includes(val)) {
            c.append(<div class="form-group"><label>Fluxo (L/me)*</label><input type="number" class="form-control" name="fluxo" max="99" required /></div>);
        } else if (['Ventilação mecânica', 'Ventilação não-invasiva'].includes(val)) {
            c.append(<div class="form-row">
                <div class="form-group col-md-4"><label>FiO₂ (%)*</label><input type="number" class="form-control" name="fio2" max="99" required /></div>
                <div class="form-group col-md-4"><label>Sat O₂ (%)*</label><input type="number" class="form-control" name="sat_vent" max="999" required /></div>
                <div class="form-group col-md-4"><label>PEEP*</label><input type="number" class="form-control" name="peep" max="99" required /></div>
            </div>);

            // Limitar dígitos nesses campos também após adicionar
            setTimeout(() => {
                limitarDigitos(document.querySelector('[name="fio2"]'), 3);
                limitarDigitos(document.querySelector('[name="sat_vent"]'), 3);
                limitarDigitos(document.querySelector('[name="peep"]'), 2);
            }, 100);
        } else if (val === 'CPAP') {
            c.append(<div class="form-row">
                <div class="form-group col-md-6"><label>Sat O₂ (%)*</label><input type="number" class="form-control" name="sat_cpap" max="999" required /></div>
                <div class="form-group col-md-6"><label>PEEP*</label><input type="number" class="form-control" name="peep_cpap" max="99" required /></div>
            </div>);

            // Limitar dígitos nesses campos após adicionar
            setTimeout(() => {
                limitarDigitos(document.querySelector('[name="sat_cpap"]'), 3);
                limitarDigitos(document.querySelector('[name="peep_cpap"]'), 2);
            }, 100);
        }
    });

    // Exibe campos de isolamento/drogas
    $('#isolamentoSel').change(function () {
        $('#germeContainer').toggle($(this).val() === 'Sim');
        $('[name="germe"]').prop('required', $(this).val() === 'Sim');
    });

    $('#vasoSel').change(function () {
        const show = $(this).val() === 'Sim';
        $('#vasoFields, #doseFields').toggle(show);
        $('[name="nome_vaso"], [name="dose_vaso"]').prop('required', show);
    });
</script>

</body>
</html>
